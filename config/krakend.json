{
  "$schema": "https://www.krakend.io/schema/v2.8/krakend.json",
  "version": 3,
  "endpoints": [
    {
      "endpoint": "/time",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/time",
          "host": ["http://time-app:3000"]
        }
      ]
    },
    {
      "endpoint": "/users",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/users",
          "host": ["http://users-app:3000"],
          "is_collection": true
        }
      ]
    }
  ]
}
